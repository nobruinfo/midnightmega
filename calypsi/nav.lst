1558                      case 0x5f: // left (for updir)
1559                      case 3:    // STOP
1560                      case 27:   // Esc
1561                        if ((midnight[side]->flags & MIDNIGHTFLAGismounted) == FALSE)  {
1562                          for (i = 0; i <= midnight[side]->entries; i++)  {
1563                            ds = getdirententry(side, i);
1564                            
1565                            if ((ds->type & HYPPODIRENTATTRDIR) &&
1566                                (ds->name[0] == '.' && ds->name[1] == '.'))  {
1567                              hyppo_setname((char *) ds->name);
1568                              attachresult = hyppo_chdir();
1569
1570                              if (attachresult > 0xf)  {  // @@ better error handling in Hyppo reqd
1571                                messagebox(MBOXNOCANCEL, "Storage card parent directory,",
1572                                           "open failed for", (char *) ds->name, 0);
1573                              } else {
1574                                UpdateSectors(midnight[side]->drive, side);
1575                                Deselect(side);
1576                              }
1577                            }
1578                          }
1579                        } else {
1580                          midnight[side]->dirtrack = HEADERTRACK;
1581                          midnight[side]->firsttrack = FIRSTTRACK;
1582                          midnight[side]->lasttrack = LASTTRACK;
1583                          UpdateSectors(midnight[side]->drive, side);
1584                          Deselect(side);
1585                        }
1586                      break;
1587
1588                      case 0x20: // Space to toggle
1589                      case 0x194: // Shift-Inst
1590                      case 0x294:
1591                        if ((midnight[side]->flags & MIDNIGHTFLAGismounted) == FALSE)  {
1592                          sidbong();
1593                        } else {
1594                          direntflags[side][midnight[side]->pos].flags ^= DIRFLAGSisselected;
1595                          if (!(midnight[side]->flags & MIDNIGHTFLAGdirsortactive))  {
1596                            midnight[side]->pos++;
1597                          }
1598                        }
1599                      break;
1600
1601                      case 13: // return
1602                        ds = getdirententry(side, midnight[side]->pos);
1603                        lcopy(ATTICLFNBUFFER + side * ATTICLFNBUFFERSIZE + midnight[side]->pos * LFNFILENAMELEN,
1604                             (uint32_t) lfnname,
1605                             LFNFILENAMELEN);
1606
1607                        if ((midnight[side]->flags & MIDNIGHTFLAGismounted) == FALSE)  {
1608                          if (ds->type & HYPPODIRENTATTRDIR)  {
1609                            hyppo_setname((char*) lfnname);  // ds->name);
1610                            attachresult = hyppo_chdir();
1611
1612                            if (attachresult > 0xf)  {  // @@ better error handling in Hyppo reqd
1613                              messagebox(MBOXNOCANCEL, "Storage card change directory,",
1614                                         "open failed for", (char *) ds->name, 0);
1615                            } else {
1616                              UpdateSectors(midnight[side]->drive, side);
1617                              Deselect(side);
1618                            }        
1619                          } else {
1620                            // @@@@ currently trying to mount everything that is not a dir:
1621                            if (midnight[side]->drive)  {
1622                              hyppo_setname((char *) lfnname); // (char *) ds->name);
1623                              attachresult = (legacyHDOSstate ? hyppo_d81attach1() : hyppo_dos_attach(1));
1624                            } else {
1625                              hyppo_setname((char *) lfnname); // (char *) ds->name);
1626                              attachresult = (legacyHDOSstate ? hyppo_d81attach0() : hyppo_dos_attach(0));
1627                            }
1628
1629                            if (attachresult > 0x4a)  { // @@@@ to be reviewed
1630                              messagebox(MBOXNOCANCEL, "Storage card mounting,",
1631                                         "mount failed for",
1632                                         (char *) lfnname, 0); // ds->name, 0);
1633                            } else {
1634                              midnight[side]->flags |= MIDNIGHTFLAGismounted;
1635                              UpdateSectors(midnight[side]->drive, side);
1636                              Deselect(side);
1637                            }
1638                          }
1639                        } else {
1640                          if ((ds->type&0xf) == VAL_DOSFTYPE_CBM &&
