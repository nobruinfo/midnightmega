1425                                         // "number=", number))  {
1426                                         "start-/endtrack=",
1427                                         starttrack * 256 + endtrack);
1428                #endif
1429                              // First allocate BAM because the following format will use
1430                              // the BAM of the partition:
1431                              BAMAllocateTracks(legacyHDOSstate, side, starttrack, endtrack);
1432                              PutBAM(legacyHDOSstate,
1433                                     midnight[side]->drive, side, midnight[side]->dirtrack);
1434
1435                              ds->chntrack = 0;
1436                              ds->chnsector = 0;
1437                              ds->type = VAL_DOSFTYPE_CBM | 0x80;
1438                              ds->track = starttrack;  // recycle src dirent for destination
1439                              ds->sector = 0;
1440                              strmakefilename((char*) midnight[side]->inputstr,
1441                                              (char*) ds->name, DOSFILENAMELEN);
1442                              ds->size = (endtrack - starttrack) * 40; // omit dirtrack
1443                              writenewdirententry(legacyHDOSstate,
1444                                                  midnight[side]->drive, side,
1445                                                  midnight[side]->dirtrack,
1446                                                  midnight[side]->firsttrack,
1447                                                  midnight[side]->lasttrack,
1448                                                  ds);
1449                              FormatPartition(legacyHDOSstate, midnight[side]->drive, side,
1450                                              starttrack, // midnight[side]->dirtrack,
1451                                              starttrack, // midnight[side]->firsttrack,
1452                                              endtrack,   // midnight[side]->lasttrack);
1453                                              (char*) ds->name);
1454
1455                              UpdateSectors(midnight[side]->drive, side);
1456                              Deselect(side);
1457                            } else {
