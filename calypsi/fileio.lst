0533                // @@@@ debug
0534                // unsigned char* const basepage = (unsigned char*) BASEPAGERESERVED;
0535                unsigned char BAMFreeTracksinaRow(BAM* BAMsector, BAM* BAMsector2,
0536                                     unsigned char firsttrack, unsigned char lasttrack,
0537                                     unsigned char * starttrack, unsigned char * endtrack,
0538                                     unsigned char nboftracks) {
0539                  unsigned char track80;
0540                  unsigned char track;
0541                  unsigned char number = 0;
0542                  unsigned char numberprev = 0;
0543                  unsigned char starttrackprev = 0;
0544                  unsigned char endtrackprev = 0;
0545
0546                  *starttrack = 0; // to return the range matching the number of requested
0547                  *endtrack = 0;   // tracks
0548
0549                  // access track array zero based
0550                  for (track80 = (firsttrack - 1); track80 < lasttrack; track80++)  {
0551                    // next BAM sector of two in total:
0552                    if (track80 < 40)  {
0553                      track = track80;
0554                    } else {
0555                      track = track80 - 40;
0556                      BAMsector = BAMsector2;
0557                    }
0558
0559                    if (BAMsector->entry[track].free >= 40)  {
0560                      if (*starttrack == 0)  *starttrack = track80 + 1;
0561                      number ++;
0562                    } else {
0563                      if (number)  {
0564                        *endtrack = track80;
0565                        if ((*endtrack - *starttrack) >= (nboftracks - 1))  {
0566                          // weak strategy to find lowest track count in a row:
0567                          if ((*endtrack - *starttrack) >= (endtrackprev - starttrackprev)) {
0568                            endtrackprev = *endtrack;
0569                            starttrackprev = *starttrack;
0570                          } else {
0571                            *endtrack = endtrackprev;
0572                            *starttrack = starttrackprev;
0573                          }
0574                        } else {  // requested number of tracks not met:
0575                          *endtrack = 0;
0576                          *starttrack = 0;
0577                        }
0578                      }
0579                      number = 0; // re-begin finding biggest consecutive number
0580                    }
0581                  }
0582
0583                  // determine last track being unallocated:
0584                  if ((*starttrack + number) > lasttrack)  *endtrack = lasttrack;
0585
0586                //  basepage[0] = number;      // @@@@ debug
0587                //  basepage[1] = *starttrack; // @@@@ debug
0588                //  basepage[2] = *endtrack;   // @@@@ debug
0589
0590                  return number;
0591                }
