0427                // this expects data in sector buffer:
0428                void BAMSectorUpdate(BAM* BAMsector, BAM* BAMsector2, char track, char sector, char set) {
0429                  unsigned char bitshifter = 1;
0430
0431                //  BAMsector += $100;  // @@@@@ dirty test
0432                //  mprintf("BAMSectorUpdate BAMsector is:", (unsigned long) BAMsector);
0433
0434                  // next BAM sector of two in total:
0435                  if (track > 40)  {
0436                    track -= 40;
0437                    BAMsector = BAMsector2;
0438                  }
0439                #ifdef DEBUG
0440                        gotoxy(42, 20);
0441                        mh4printf("BAMsector ", (long) BAMsector);
0442                        cputln();
0443                        cgetc();
0444                #endif
0445                  
0446                  track--;  // access array zero based
0447                  if (set)  {  // if set clear alloc bit below to allocate:
0448                    if (sector < 8)  {
0449                      BAMsector->entry[track].alloc1 &= ~(bitshifter << sector);
0450                    }
0451                    else if (sector < 16)  {
0452                      BAMsector->entry[track].alloc2 &= ~(bitshifter << (sector - 8));
0453                    }
0454                    else if (sector < 24)  {
0455                      BAMsector->entry[track].alloc3 &= ~(bitshifter << (sector - 16));
0456                    }
0457                    else if (sector < 32)  {
0458                      BAMsector->entry[track].alloc4 &= ~(bitshifter << (sector - 24));
0459                    }
0460                    else  {
0461                      BAMsector->entry[track].alloc5 &= ~(bitshifter << (sector - 32));
0462                    }
0463                    BAMsector->entry[track].free--;
0464                  }
0465                  else  {
0466                    if (sector < 8)  {
0467                      BAMsector->entry[track].alloc1 |= (bitshifter << sector);
0468                    }
0469                    else if (sector < 16)  {
0470                      BAMsector->entry[track].alloc2 |= (bitshifter << (sector - 8));
0471                    }
0472                    else if (sector < 24)  {
0473                      BAMsector->entry[track].alloc3 |= (bitshifter << (sector - 16));
0474                    }
0475                    else if (sector < 32)  {
0476                      BAMsector->entry[track].alloc4 |= (bitshifter << (sector - 24));
0477                    }
0478                    else  {
0479                      BAMsector->entry[track].alloc5 |= (bitshifter << (sector - 32));
0480                    }
0481                    BAMsector->entry[track].free++;
0482                  }
0483                }
0484
0485                unsigned int BAMSectorsFreeBlocks(BAM* BAMsector, BAM* BAMsector2,
0486                                     unsigned char dirtrack,
0487                                     unsigned char firsttrack, unsigned char lasttrack) {
0488                  unsigned char track80;
0489                  unsigned char track;
0490                  unsigned int free = 0;
0491
0492                  // access track array zero based
0493                  for (track80 = (firsttrack - 1); track80 < lasttrack; track80++)  {
0494                    // next BAM sector of two in total:
0495                    if (track80 < 40)  {
0496                      track = track80;
0497                    } else {
0498                      track = track80 - 40;
0499                      BAMsector = BAMsector2;
0500                    }
0501
0502                    if (track80 != (dirtrack - 1))  {
0503                      free += BAMsector->entry[track].free;
0504                    }
0505                  }
0506
0507                  return free;
0508                }
