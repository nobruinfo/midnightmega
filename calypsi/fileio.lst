0512                                        unsigned char firsttrack, unsigned char lasttrack) {
0513                  GetBAM(legacyHDOSstate, side);
0514                  return BAMSectorsFreeBlocks(BAMsector[0], BAMsector[1], dirtrack,
0515                                              firsttrack, lasttrack);
