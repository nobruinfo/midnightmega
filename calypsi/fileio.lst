0593                unsigned char FreeTracks(unsigned char legacyHDOSstate,
0594                                         unsigned char side,
0595                                         unsigned char firsttrack, unsigned char lasttrack,
0596                                         unsigned char * starttrack, unsigned char * endtrack,
0597                                         unsigned char nboftracks) {
0598                  GetBAM(legacyHDOSstate, side);
0599                  return BAMFreeTracksinaRow(BAMsector[0], BAMsector[1],
0600                                             firsttrack, lasttrack,
0601                                             starttrack, endtrack, nboftracks);
0602                }
0603
0604                #define ID_i 'I'
0605                #define ID_d 'D'
0606                void FormatPartition(unsigned char legacyHDOSstate,
0607                                     unsigned char drive, unsigned char side,
0608                                     unsigned char dirtrack,
0609                                     unsigned char firsttrack, unsigned char lasttrack,
0610                                     char* name)  {
0611                  BAM* bs;
0612                  BAM* bs1;
0613                  HEADER* hs;
0614                  unsigned char track;
0615
0616                  bs = BAMsector[0];
0617                  bs1 = BAMsector[1];
0618                  hs = (HEADER *) BAMsector[0];
0619
0620                  // do it all backwards to profit from BAM similarities.
0621
0622                  // create first empty dirent sector:
0623                  lfill((uint32_t) bs1, 0, BLOCKSIZE);
0624                  bs1->chnsector = 0xff;
0625
0626                  // now BAM sectors:
0627                  bs->chntrack = 0;   // second BAM sector first
0628                  bs->chnsector = 0xff;  // next sector of BAM
0629                  bs->version = 0x44;
0630                  bs->versioninvert = 0xbb;
0631                  bs->diskid1 = ID_i;  // @@@@@
0632                  bs->diskid2 = ID_d;
0633                  bs->io = 0x40;
0634                  // for (i = 0x07; i <= 0x0f; i++)  bs[i] = 0;
0635                  lfill((uint32_t) bs + 0x07, 0, 0x0f - 0x07 + 1); // clear bytes 07..0f
0636                  for (track = 0; track < 40; track++)  {
0637                    if ((track + 41) == dirtrack)  {
0638                      bs->entry[track].free = 0x24;  // occupy header, BAM and dirent
0639                      bs->entry[track].alloc1 = 0xf0;
0640                    } else {
0641                      bs->entry[track].free = 0x28;
0642                      bs->entry[track].alloc1 = 0xff;
0643                    }
0644                    bs->entry[track].alloc2 = 0xff;
0645                    bs->entry[track].alloc3 = 0xff;
0646                    bs->entry[track].alloc4 = 0xff;
0647                    bs->entry[track].alloc5 = 0xff;
0648                  }
0649                  progress("Writing...", "directory/BAM", 30);
0650                  PutWholeSector(legacyHDOSstate, (BAM *) bs, drive, dirtrack, BAMSECT + 1);
0651
0652                  // both BAM sectors look almost the same:
0653                  lcopy((uint32_t) bs, (uint32_t) bs1, BLOCKSIZE);
0654
0655                  bs1->chntrack = dirtrack;  // first BAM sector points to second one
0656                  bs1->chnsector = BAMSECT + 1;  // next sector of BAM
0657                  if (dirtrack > 40)  {  // reset eventual dirtrack in upper BAM
0658                    bs1->entry[dirtrack - 41].free = 0x28;
0659                    bs1->entry[dirtrack - 41].alloc1 = 0xff;
0660                  }
0661                  if (dirtrack <= 40)  {
0662                    bs1->entry[dirtrack - 1].free = 0x24;  // occupy header, BAM and dirent
0663                    bs1->entry[dirtrack - 1].alloc1 = 0xf0;
0664                  }
0665
0666                  // create first empty header sector:
0667                  lfill((uint32_t) bs, 0, BLOCKSIZE);
0668                  hs->chntrack = dirtrack;  // first BAM sector points to second one
0669                  hs->chnsector = DIRENTSECT;
0670                  hs->diskdosversion = 0x44;
0671                  strcopy(name, (char *) hs->diskname, 16);
0672                  hs->unused1 = 0xa0;
0673                  hs->unused2 = 0xa0;
0674                  hs->diskid1 = ID_i;  // @@@@
0675                  hs->diskid2 = ID_d;
0676                  hs->unused3 = 0xa0;
0677                  hs->dosversion = 0x33;
0678                  hs->diskversion = 0x44;
0679                  hs->unused4 = 0xa0;
0680                  hs->unused5 = 0xa0;
0681
0682                  progress("Writing...", "BAM/header", 60);
0683                  PutWholeSector(legacyHDOSstate, (BAM *) bs, drive, dirtrack, HEADERSECT);
0684                }
0685
0686                void BAMAllocateTracks(unsigned char legacyHDOSstate, unsigned char side,
0687                                       unsigned char starttrack, unsigned char endtrack) {
0688                  unsigned char track80;
0689                  unsigned char sector;
0690
0691                  GetBAM(legacyHDOSstate, side);
0692                  for (track80 = starttrack; track80 <= endtrack; track80++)  {
0693                    for (sector = 0; sector < 40; sector++)  {
0694                      BAMSectorUpdate(BAMsector[0], BAMsector[1], track80, sector, 1); // 1=allocate
0695                    }
0696                  }
0697                }
