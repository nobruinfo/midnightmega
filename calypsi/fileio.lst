0699                // @@@@ this has old filename handling and uses a BAM sector instead
0700                // @@@@ of passing a pointer:
0701                void getDiskname(unsigned char legacyHDOSstate,
0702                                 unsigned char drive, unsigned char dirtrack, char* diskname) {
0703                  HEADER* hs;
0704                  unsigned char i;
0705
0706                  // _miniInit();
0707
0708                  if (GetOneSector(legacyHDOSstate,
0709                                   BAMsector[0], drive, dirtrack, HEADERSECT) < 2)  {
0710                    hs = (HEADER*) BAMsector[0];
0711
0712                    i = 0;
0713                    while (hs->diskname[i] != 0xa0 && i < DOSFILENAMELEN)  {
0714                      diskname[i] = hs->diskname[i];
0715                      i++;
0716                    }
0717                    diskname[i] = 0;
0718                  } else {
0719                    strcopy("read error", (char *) diskname, 16);
0720                  }
0721                }
