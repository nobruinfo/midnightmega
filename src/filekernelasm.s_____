; KERNAL Vektoren
SETLFS = $ffba
SETNAM = $ffbd
OPEN   = $ffc0
CHKIN  = $ffc6
CHRIN  = $ffcf
CLOSE  = $ffc3
CLRCHN = $ffcc

.section zp
ptr: .space 2
dev: .space 1

.section code

; --- Routine 1: Kanal öffnen ---
.public _disk_open_cmd
_disk_open_cmd:
    sta dev
    stx ptr
    sty ptr+1

    ldy #0
len_loop:
    lda (ptr),y
    beq len_done
    iny
    bne len_loop
len_done:
    tya             ; Länge in A
    ldx ptr         ; Pointer zurück in X/Y
    ldy ptr+1
    jsr SETNAM

    lda #15         ; Logische Datei 15
    ldx dev         ; Gerät (z.B. 8)
    ldy #15         ; Sekundäradresse 15
    jsr SETLFS
    jsr OPEN

    lda #0
    jsr SETNAM
    lda #2         ; Logische Datei 2
    ldx dev        ; Gerät (z.B. 8)
    ldy #2         ; Sekundäradresse 2
    jsr SETLFS
    jsr OPEN
    rts

; --- Routine 2: Lesen und Schließen ---
.public _disk_read_to_addr
_disk_read_to_addr:
    stx ptr
    sty ptr+1

    ldx #2          ; Kanal 2 für Input wählen
    jsr CHKIN

    ldy #0
read_loop:
    jsr CHRIN
    sta (ptr),y
    iny
    bne read_loop

    jsr CLRCHN      ; Standard-I/O wiederherstellen
    
    ; KORREKTUR: CLOSE benötigt nur die logische ID in A
    lda #2          ; Logische Datei 2
    jsr CLOSE
    
    lda #15         ; Logische Datei 15
    jsr CLOSE
    rts
