0267                void togglecase(void)
0268                {
0269                    POKE(0xD018U, PEEK(0xD018U) ^ 0x02);
0270                }
0271                
0272                void clrscr(void)
0273                {
0274                    const unsigned int cBytes
0275                        = (unsigned int)g_curScreenW * g_curScreenH * (IS_16BITCHARSET ? 2 : 1);
0276                    lfill(SCREEN_RAM_BASE, ' ', cBytes);
0277                    lfill(COLOR_RAM_BASE, g_curTextColor, cBytes);
0278                }
