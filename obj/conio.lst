0026                #define VIC_BASE 0xD000UL
0027                #define IS_H640 (PEEK(VIC_BASE + 0x31) & 128)
0028                #define IS_V400 (PEEK(VIC_BASE + 0x31) & 8)
0029                #define SET_H640() POKE(VIC_BASE + 0x31, PEEK(VIC_BASE + 0x31) | 128)
0030                #define CLEAR_H640() POKE(VIC_BASE + 0x31, PEEK(VIC_BASE + 0x31) & 127)
0031                #define SET_V400() POKE(VIC_BASE + 0x31, PEEK(VIC_BASE + 0x31) | 8)
0032                #define CLEAR_V400() POKE(VIC_BASE + 0x31, PEEK(VIC_BASE + 0x31) & 0xF7)
0033                #define IS_16BITCHARSET (PEEK(VIC_BASE + 0x54) & 1)
0034                #define SET_16BITCHARSET() POKE(VIC_BASE + 0x54, PEEK(VIC_BASE + 0x54) | 1)
0035                #define CLEAR_16BITCHARSET() POKE(VIC_BASE + 0x54, PEEK(VIC_BASE + 0x54) & 0xFE)
0036                #define SET_HOTREGS() POKE(VIC_BASE + 0x5D, PEEK(VIC_BASE + 0x5D) | 128)
0037                #define CLEAR_HOTREGS() POKE(VIC_BASE + 0x5D, PEEK(VIC_BASE + 0x5D) & 127)
0038                #define IS_EXTATTR() (PEEK(VIC_BASE + 0x31) & 32)
0039                #define SET_EXTATTR() POKE(VIC_BASE + 0x31, PEEK(VIC_BASE + 0x31) | 32)
0040                #define CLEAR_EXTATTR() POKE(VIC_BASE + 0x31, PEEK(VIC_BASE + 0x31) & 0xDF)
0041                #define SCREEN_RAM_BASE_B0 (PEEK(VIC_BASE + 0x60)) // LSB
0042                #define SCREEN_RAM_BASE_B1 (PEEK(VIC_BASE + 0x61))
0043                #define SCREEN_RAM_BASE_B2 (PEEK(VIC_BASE + 0x62))
0044                #define SCREEN_RAM_BASE_B3 (PEEK(VIC_BASE + 0x63) & 7) // upper nybble
0045                #define SCREEN_RAM_BASE                                                        \
0046                    (((unsigned long)SCREEN_RAM_BASE_B3 << 24)                                 \
0047                        | ((unsigned long)SCREEN_RAM_BASE_B2 << 16)                            \
0048                        | ((unsigned long)SCREEN_RAM_BASE_B1 << 8)                             \
0049                        | ((unsigned long)SCREEN_RAM_BASE_B0))
