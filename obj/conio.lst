0289                
0290                void textcolor(unsigned char c)
0291                {
0292                    g_curTextColor = (g_curTextColor & 0xF0) | (c & 0xf);
0293                }
0294                
0295                void cellcolor(unsigned char x, unsigned char y, unsigned char c)
0296                {
0297                    lpoke(COLOR_RAM_BASE + (y * (unsigned int)g_curScreenW) + x, c);
0298                }
0299                
0300                void revers(unsigned char enable)
0301                {
0302                    if (enable) {
0303                        g_curTextColor |= ATTRIB_REVERSE;
0304                    }
0305                    else {
0306                        g_curTextColor &= ~ATTRIB_REVERSE;
0307                    }
0308                }
0309                
0310                void highlight(unsigned char enable)
