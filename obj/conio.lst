0109                    // Make sure we go to VIC-IV IO mode
0110                
0111                    POKE(0xD02fL, 0x47);
    \ 0000 a947                 lda     #71
    \ 0002 8d2fd0               sta     0xd02f
0112                    POKE(0xd02fL, 0x53);
    \ 0005 a953                 lda     #83
    \ 0007 8d2fd0               sta     0xd02f
0113                
0114                    sethotregs(0);
    \ 000a a900                 lda     #0
    \ 000c 20....               jsr     sethotregs
0115                    setlowercase();
0116                
0117                    g_curScreenW = IS_H640 ? 80 : 40;
0118                    g_curScreenH = IS_V400 ? 50 : 25;
0119                
0120                    flushkeybuf();
0121                }
0122                
0123                char petsciitoscreencode(char c)
0124                {
0125                    if (c >= 64 && c <= 95) {
0126                        return c - 64;
0127                    }
0128                
0129                    if (c >= 192) {
0130                        return c - 128;
0131                    }
0132                
0133                    if (c >= 96 && c < 192) {
0134                        return c - 32;
0135                    }
0136                
0137                    if (c == '_') {
0138                        return 100;
0139                    }
0140                
0141                    return c;
0142                }
0143                
0144                char* petsciitoscreencode_s(char* s)
0145                {
0146                    char* src = s;
0147                    char* dest = p2sbuf;
0148                    // This loop intentionally uses assignment in the test condition
0149                    while ((*dest++ = petsciitoscreencode(*src++)))
0150                        ;
0151                    return p2sbuf;
0152                }
0153                
0154                void setscreenaddr(unsigned long address)
0155                {
0156                    POKE(VIC_BASE + 0x60, address & 0x0000FFUL);
0157                    POKE(VIC_BASE + 0x61, (address & 0xFF00UL) >> 8);
0158                    POKE(VIC_BASE + 0x62, (address & 0xFF0000UL) >> 16);
0159                    POKE(VIC_BASE + 0x63,
0160                        (PEEK(VIC_BASE + 0x63) & 0xF) | ((address & 0xF000000UL) >> 24));
0161                }
0162                
0163                unsigned long getscreenaddr(void)
0164                {
0165                    return SCREEN_RAM_BASE;
0166                }
0167                
0168                void setcharsetaddr(unsigned long address)
0169                {
0170                    POKE(VIC_BASE + 0x68, address & 0x0000FFUL);
0171                    POKE(VIC_BASE + 0x69, (address & 0xFF00UL) >> 8);
0172                    POKE(VIC_BASE + 0x6A, (address & 0xFF0000UL) >> 16);
0173                }
0174                
0175                long getcharsetaddr(void)
0176                {
0177                    return ((long)PEEK(VIC_BASE + 0x68)) | ((long)PEEK(VIC_BASE + 0x69) << 8)
0178                         | (((long)PEEK(VIC_BASE + 0x6A) << 16));
0179                }
0180                
0181                void setcolramoffset(unsigned int offset)
0182                {
0183                    POKE(VIC_BASE + 0x64, offset & 0x00FFUL);
0184                    POKE(VIC_BASE + 0x65, (offset & 0xFF00UL) >> 8);
0185                }
0186                
0187                unsigned int getcolramoffset(void)
0188                {
0189                    return ((unsigned int)PEEK(VIC_BASE + 0x64)
0190                            | ((unsigned int)PEEK(VIC_BASE + 0x65)) << 8);
0191                }
0192                
0193                void setscreensize(unsigned char w, unsigned char h)
0194                {
0195                    if (w == 80) {
0196                        SET_H640();
0197                        // compensate for vic-iii h640 horizontal positioning bug
0198                        POKE(0xd04c, 0x50);
0199                    }
0200                    else if (w == 40) {
0201                        CLEAR_H640();
0202                        POKE(0xd04c, 0x4e);
0203                    }
0204                
0205                    if (h == 50) {
0206                        SET_V400();
0207                    }
0208                    else if (h == 25) {
0209                        CLEAR_V400();
0210                    }
0211                
0212                    // Cache values.
0213                    if (w == 40 || w == 80) {
0214                        g_curScreenW = w;
0215                    }
0216                    if (h == 25 || h == 50) {
0217                        g_curScreenH = h;
0218                    }
0219                }
0220                
0221                void getscreensize(unsigned char* width, unsigned char* height)
0222                {
0223                    *width = g_curScreenW;
0224                    *height = g_curScreenH;
0225                }
0226                
0227                void set16bitcharmode(unsigned char f)
0228                {
0229                    if (f) {
0230                        SET_16BITCHARSET();
0231                    }
0232                    else {
0233                        CLEAR_16BITCHARSET();
0234                    }
0235                }
0236                
0237                void sethotregs(unsigned char f)
0238                {
0239                    if (f) {
0240                        SET_HOTREGS();
0241                    }
0242                    else {
0243                        CLEAR_HOTREGS();
0244                    }
0245                }
0246                
0247                void setextendedattrib(unsigned char f)
0248                {
0249                    if (f) {
0250                        SET_EXTATTR();
0251                    }
0252                    else {
0253                        CLEAR_EXTATTR();
0254                    }
0255                }
