0415                
0416                unsigned char _cprintf(
0417                    const unsigned char translateCodes, const unsigned char* fmt, ...)
0418                {
0419                //    unsigned char printfState = PRINTF_STATE_INIT;
0420                //    unsigned char escHash = 0;
0421                    unsigned char cch = 0;
0422                
0423                    while (*fmt) {
0424                //        switch (printfState) {
0425                //        case PRINTF_STATE_INIT:
0426                            switch (*fmt) {
0427                            case '{':
0428                //                printfState = PRINTF_STATE_ESCAPE;
0429                                break;
0430                
0431                            case '\t': // Tab
0432                                // moveleft((g_curX + 7) / 8) * 8, 1);
0433                                break;
0434                
0435                            case '\n': // New-line
0436                                gotoxy(0, g_curY + 1);
0437                                break;
0438                
0439                            default:
0440                                cputc(translateCodes ? petsciitoscreencode(*fmt) : *fmt);
0441                            }
0442                            break;
0443                /*
0444                        case PRINTF_STATE_ESCAPE:
0445                            if (*fmt == '{') // print literal
0446                            {
0447                                cputc(*fmt);
0448                                printfState = PRINTF_STATE_INIT;
0449                                break;
0450                            }
0451                
0452                            cch = 0;
0453                            while (fmt && (*fmt != '}')) {
0454                                fmt++;
0455                                cch++;
0456                            }
0457                
0458                            if (*fmt != '}') { // bailout.
0459                                return 255;
0460                            }
0461                
0462                            escHash = hash(fmt - cch, cch);
0463                            escapeCode[escHash].fn(escapeCode[escHash].arg);
0464                            printfState = PRINTF_STATE_INIT;
0465                            break;
0466                        }
0467                */
0468                
0469                        fmt++;
0470                    }
0471                    // PGS 20240117 - What is the correct return value?
0472                    return 0;
0473                }
0474                
0475                void cputhex(unsigned long n, unsigned char prec)
0476                {
0477                    unsigned char buffer[10];
0478                    buffer[0] = '$';
0479                    buffer[1] = hexDigits[(n & 0xF0000000UL) >> 28];
0480                    buffer[2] = hexDigits[(n & 0x0F000000UL) >> 24];
0481                    buffer[3] = hexDigits[(n & 0x00F00000UL) >> 20];
0482                    buffer[4] = hexDigits[(n & 0x000F0000UL) >> 16];
0483                    buffer[5] = hexDigits[(n & 0x0000F000UL) >> 12];
0484                    buffer[6] = hexDigits[(n & 0x00000F00UL) >> 8];
0485                    buffer[7] = hexDigits[(n & 0x000000F0UL) >> 4];
0486                    buffer[8] = hexDigits[(n & 0x0000000FUL)];
0487                    buffer[9] = '\0';
0488                    buffer[8 - prec] = '$';
0489                    cputs(&buffer[8 - prec]);
0490                }
0491                
0492                void cputdec(unsigned long n, unsigned char padding __attribute__((unused)),
0493                    unsigned char leadingZeros)
0494                {
0495                    unsigned char buffer[11];
0496                    unsigned char rem = 0;
0497                    unsigned char digit = 9;
0498                
0499                    buffer[10] = '\0';
0500                    do {
0501                        rem = n % 10;
0502                        n /= 10;
0503                        buffer[digit--] = hexDigits[rem];
0504                    } while (((int)digit >= 0) && (n != 0));
0505                
0506                    while (((int)digit >= 0) && (leadingZeros--)) {
0507                        buffer[digit--] = hexDigits[0];
0508                    }
0509                
0510                    cputs(&buffer[digit + 1]);
0511                }
0512                
0513                void cputs(const unsigned char* s)
0514                {
0515                    cputsxy(g_curX, g_curY, s);
0516                }
0517                
0518                void cputsxy(unsigned char x, unsigned char y, const unsigned char* s)
0519                {
0520                    const unsigned char len = (unsigned char)strlen((const char*)s);
0521                    const unsigned int offset = (y * (unsigned int)g_curScreenW) + x;
0522                    lcopy((unsigned long)s, SCREEN_RAM_BASE + offset, len);
0523                    lfill(COLOR_RAM_BASE + offset, g_curTextColor, len);
0524                    g_curY = y + ((x + len) / g_curScreenW);
0525                    g_curX = (x + len) % g_curScreenW;
0526                }
0527                
0528                void cputcxy(unsigned char x, unsigned char y, unsigned char c)
0529                {
0530                    const unsigned int offset = (y * (unsigned int)g_curScreenW) + x;
0531                    lpoke(SCREEN_RAM_BASE + offset, c);
0532                    lpoke(COLOR_RAM_BASE + offset, g_curTextColor);
0533                    g_curX = (x == g_curScreenW - 1) ? 0 : (x + 1);
0534                    g_curY = (x == g_curScreenW - 1) ? (y + 1) : y;
0535                }
0536                
0537                void cputncxy(
0538                    unsigned char x, unsigned char y, unsigned char count, unsigned char c)
0539                {
0540                    const unsigned int offset = (y * (unsigned int)g_curScreenW) + x;
0541                    lfill(SCREEN_RAM_BASE + offset, c, count);
0542                    lfill(COLOR_RAM_BASE + offset, g_curTextColor, count);
0543                    g_curY = y + ((x + count) / g_curScreenW);
0544                    g_curX = (x + count) % g_curScreenW;
0545                }
0546                
0547                void fillrect(const RECT* rc, unsigned char ch, unsigned char col)
0548                {
0549                    register unsigned char i = 0;
0550                    const unsigned char len = rc->right - rc->left;
0551                    for (i = rc->top; i <= rc->bottom; ++i) {
0552                        const unsigned int offset = (i * (unsigned int)g_curScreenW) + rc->left;
0553                        lfill(SCREEN_RAM_BASE + offset, ch, len);
0554                        lfill(COLOR_RAM_BASE + offset, col, len);
0555                    }
0556                }
0557                
0558                void box(const RECT* rc, unsigned char color, unsigned char style,
0559                    unsigned char clear, unsigned char shadow)
0560                {
0561                    register unsigned char i = 0;
0562                    const unsigned char len = rc->right - rc->left;
0563                    unsigned char prevCol = g_curTextColor;
0564                #ifndef __CC65__
0565                    const unsigned char chTopLeft[] = { 0x20, 0x20, 0x70, 0x4F, 0x55 };
0566                    const unsigned char chTopRight[] = { 0x20, 0x20, 0x6E, 0x50, 0x49 };
0567                    const unsigned char chBottomLeft[] = { 0x20, 0x20, 0x6D, 0x4C, 0x4A };
0568                    const unsigned char chBottomRight[] = { 0x20, 0x20, 0x7D, 0x7A, 0x4B };
0569                    const unsigned char chHorzTop[] = { 0x20, 0x64, 0x43, 0x77, 0x43 };
0570                    const unsigned char chHorzBottom[] = { 0x20, 0x63, 0x43, 0x6F, 0x43 };
0571                    const unsigned char chVertRight[] = { 0x20, 0x74, 0x5D, 0x6A, 0x5D };
0572                    const unsigned char chVertLeft[] = { 0x20, 0x6A, 0x5D, 0x74, 0x5D };
0573                #endif
0574                    textcolor(color);
0575                    if (clear) {
0576                        fillrect(rc, ' ', g_curTextColor);
0577                    }
0578                
0579                    cputcxy(rc->left, rc->top, chTopLeft[style]);
0580                    cputcxy(rc->left, rc->bottom, chBottomLeft[style]);
0581                    cputcxy(rc->right, rc->top, chTopRight[style]);
0582                    cputcxy(rc->right, rc->bottom, chBottomRight[style]);
0583                
0584                    for (i = 1; i < len; ++i) {
0585                        cputcxy(rc->left + i, rc->top, chHorzTop[style]);
0586                        cputcxy(rc->left + i, rc->bottom, chHorzBottom[style]);
0587                    }
0588                
0589                    for (i = rc->top + 1; i <= rc->bottom - 1; ++i) {
0590                        cputcxy(rc->left, i, chVertLeft[style]);
0591                        cputcxy(rc->right, i, chVertRight[style]);
0592                    }
0593                
0594                    if (shadow && rc->bottom < g_curScreenH && rc->right < g_curScreenW) {
0595                        lfill(COLOR_RAM_BASE + ((rc->bottom + 1) * (unsigned int)g_curScreenW)
0596                                  + (1 + rc->left),
0597                            COLOUR_DARKGREY, len);
0598                        for (i = rc->top + 1; i <= rc->bottom + 1; ++i) {
0599                            cellcolor(rc->right + 1, i, COLOUR_DARKGREY);
0600                        }
0601                    }
0602                    textcolor(prevCol);
0603                }
0604                
0605                void hline(
0606                    unsigned char x, unsigned char y, unsigned char len, unsigned char style)
0607                {
0608                    cputncxy(x, y, len, style);
0609                }
