0104                  char status;
0105
0106                  __asm volatile(
0107                    " lda %[address]\n"
0108                    " sta 0x160c\n"
0109                    " lda %[address]+1\n"
0110                    " sta 0x160d\n"
0111                /*
0112                    " jsr 0xffb7\n"       // READST
0113                    " bne end_copy\n"           // eof or error
0114                */
0115                    " ldx %[log]\n"       // as set with SETLFS
0116                    " jsr 0xffc6\n"       // CHKIN (input file)
0117                    " bcs end_copy\n"     // CHKIN error on carry
0118                /*
0119                    " jsr 0xffb7\n"       // READST error status
0120                    " bne end_copy\n"           // eof or error
0121                */
0122
0123                /*
0124                    // alternative taken from cbm_read.s:
0125                    " taz\n"       // sta     tmp1            ; Save it for later
0126                    " jsr 0xffb7\n"       // READST error status
0127                    " and #0xff\n"       //      and     #$BF
0128                    " bne end_copy\n"           // eof or error
0129                    " tza\n"       //    lda     tmp1
0130                */
0131
0132                    " ldy #0\n"           // index within block
0133                "read:\n"
0134                    " jsr 0xffcf\n"       // CHRIN
0135                //    " sta 0x1660,y\n"
0136                //    " tya\n"              // @@@@@
0137                    " sta 0x160a\n"
0138                    " sta (%[address]),y\n"
0139                    " iny\n"
0140                //    " bcc read\n"
0141                    " cpy #0x00\n"  // " cpy %[nbrbytes]\n"
0142                    " bne read\n"
0143
0144                    " sty 0x160b\n"
0145
0146                    " jsr 0xffcc\n"       // CLRCHN
0147                    "end_copy:\n"
0148                  : "=Ka"(status) : [log] "Kzp8"(log), [nbrbytes] "Kzp16"(nbrbytes),
0149                                    [address] "Kzp16"(address)
0150                     : "a", "x", "y", "z" );
    \ 0000 85..                 sta     zp:_Zp+4
    \ 0002 a5..                 lda     zp:_Zp
    \ 0004 8d0c16               sta     0x160c
    \ 0007 a5..                 lda     zp:_Zp+1
    \ 0009 8d0d16               sta     0x160d
    \ 000c a6..                 ldx     zp:_Zp+4
    \ 000e 20c6ff               jsr     0xffc6
    \ 0011 b015                 bcs     `?L76`
    \ 0013 a000                 ldy     #0
    \ 0015 20cfff   `?L75`:     jsr     0xffcf
    \ 0018 8d0a16               sta     0x160a
    \ 001b 91..                 sta     (_Zp),y
    \ 001d c8                   iny
    \ 001e c000                 cpy     #0
    \ 0020 d0f3                 bne     `?L75`
    \ 0022 8c0b16               sty     0x160b
    \ 0025 20ccff               jsr     0xffcc
    \ 0028          `?L76`:
0151                  return status;
0152                }
