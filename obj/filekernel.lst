0083                /*
0084                    " jsr 0xffb7\n"       // READST error status
0085                    " bne end_copy\n"           // eof oder fehler
0086                */
0087                    " ldy #0\n"           // index im block,  für Schleife mit y von GPT
0088                "read:\n"
0089                    " jsr 0xffcf\n"       // CHRIN
0090                    " sta (%[address]),y\n"
0091                    " iny\n"
0092                //    " bcc read\n"
0093                    " cmp	#0x0D\n"        // carriage return?
0094                    " bne read\n"
0095
0096                    " jsr 0xffcc\n"       // CLRCHN
0097                    "end_copy:\n"
0098                  : "=Ka"(status) : [log] "Kzp8"(log), [address] "Kzp16"(address)
0099                     : "a", "x", "y", "z" );
