0040                  __asm volatile(
0041                    " ; Kernal SETNAM function\n"
0042                    " ; SETNAM. Set file name parameters.\n"
0043                    " ; Input: A = File name length; X/Y = Pointer to file name.\n"
0044                    " lda %[filename_len]\n"
0045                    " ldx %[filename]\n"
0046                    " ldy %[filename] + 1\n"
0047                    " sta 0x1610\n"  // @@@@@
0048                    " stx 0x1611\n"
0049                    " sty 0x1612\n"
0050                    " jsr 0xffbd\n" // SETNAM
0051                  :  : [filename_len] "Kzp8"(filename_len), [filename] "Kzp16"(filename)
0052                     : "a", "x", "y", "z" );
