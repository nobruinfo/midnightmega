0557                // @@@@ debug
0558                // unsigned char* const basepage = (unsigned char*) BASEPAGERESERVED;
0559                unsigned char BAMFreeTracksinaRow(BAM* BAMsector, BAM* BAMsector2,
0560                                     unsigned char firsttrack, unsigned char lasttrack,
0561                                     unsigned char * starttrack, unsigned char * endtrack,
0562                                     unsigned char nboftracks) {
0563                  unsigned char track80;
0564                  unsigned char track;
0565                  unsigned char number = 0;
0566                  unsigned char numberprev = 0;
0567                  unsigned char starttrackprev = 0;
0568                  unsigned char endtrackprev = 0;
0569
0570                  *starttrack = 0; // to return the range matching the number of requested
0571                  *endtrack = 0;   // tracks
0572
0573                  // access track array zero based
0574                  for (track80 = (firsttrack - 1); track80 < lasttrack; track80++)  {
0575                    // next BAM sector of two in total:
0576                    if (track80 < 40)  {
0577                      track = track80;
0578                    } else {
0579                      track = track80 - 40;
0580                      BAMsector = BAMsector2;
0581                    }
0582
0583                    if (BAMsector->entry[track].free >= 40)  {
0584                      if (*starttrack == 0)  *starttrack = track80 + 1;
0585                      number ++;
0586                    } else {
0587                      if (number)  {
0588                        *endtrack = track80;
0589                        if ((*endtrack - *starttrack) >= (nboftracks - 1))  {
0590                          // weak strategy to find lowest track count in a row:
0591                          if ((*endtrack - *starttrack) >= (endtrackprev - starttrackprev)) {
0592                            endtrackprev = *endtrack;
0593                            starttrackprev = *starttrack;
0594                          } else {
0595                            *endtrack = endtrackprev;
0596                            *starttrack = starttrackprev;
0597                          }
0598                        } else {  // requested number of tracks not met:
0599                          *endtrack = 0;
0600                          *starttrack = 0;
0601                        }
0602                      }
0603                      number = 0; // re-begin finding biggest consecutive number
0604                    }
0605                  }
0606
0607                  // determine last track being unallocated:
0608                  if ((*starttrack + number) > lasttrack)  *endtrack = lasttrack;
0609
0610                //  basepage[0] = number;      // @@@@ debug
0611                //  basepage[1] = *starttrack; // @@@@ debug
0612                //  basepage[2] = *endtrack;   // @@@@ debug
0613
0614                  return number;
0615                }
0616
0617                unsigned char FreeTracks(unsigned char legacyHDOSstate,
0618                                         unsigned char side,
0619                                         unsigned char firsttrack, unsigned char lasttrack,
0620                                         unsigned char * starttrack, unsigned char * endtrack,
0621                                         unsigned char nboftracks) {
0622                  GetBAM(legacyHDOSstate, side);
0623                  return BAMFreeTracksinaRow(BAMsector[0], BAMsector[1],
0624                                             firsttrack, lasttrack,
0625                                             starttrack, endtrack, nboftracks);
0626                }
0627
0628                #define ID_i 'I'
0629                #define ID_d 'D'
0630                void FormatPartition(unsigned char legacyHDOSstate,
0631                                     unsigned char drive, unsigned char side,
0632                                     unsigned char dirtrack,
0633                                     unsigned char firsttrack, unsigned char lasttrack,
0634                                     char* name)  {
0635                  BAM* bs;
0636                  BAM* bs1;
0637                  HEADER* hs;
0638                  unsigned char track;
0639
0640                  bs = BAMsector[0];
0641                  bs1 = BAMsector[1];
0642                  hs = (HEADER *) BAMsector[0];
0643
0644                  // do it all backwards to profit from BAM similarities.
0645
0646                  // create first empty dirent sector:
0647                  lfill((uint32_t) bs1, 0, BLOCKSIZE);
0648                  bs1->chnsector = 0xff;
0649
0650                  // now BAM sectors:
0651                  bs->chntrack = 0;   // second BAM sector first
0652                  bs->chnsector = 0xff;  // next sector of BAM
0653                  bs->version = 0x44;
0654                  bs->versioninvert = 0xbb;
0655                  bs->diskid1 = ID_i;  // @@@@@
0656                  bs->diskid2 = ID_d;
0657                  bs->io = 0x40;
0658                  // for (i = 0x07; i <= 0x0f; i++)  bs[i] = 0;
0659                  lfill((uint32_t) bs + 0x07, 0, 0x0f - 0x07 + 1); // clear bytes 07..0f
0660                  for (track = 0; track < 40; track++)  {
0661                    if ((track + 41) == dirtrack)  {
0662                      bs->entry[track].free = 0x24;  // occupy header, BAM and dirent
0663                      bs->entry[track].alloc1 = 0xf0;
0664                    } else {
0665                      bs->entry[track].free = 0x28;
0666                      bs->entry[track].alloc1 = 0xff;
0667                    }
0668                    bs->entry[track].alloc2 = 0xff;
0669                    bs->entry[track].alloc3 = 0xff;
0670                    bs->entry[track].alloc4 = 0xff;
0671                    bs->entry[track].alloc5 = 0xff;
0672                  }
0673                  progress("Writing...", "directory/BAM", 30);
0674                  PutWholeSector(legacyHDOSstate, (BAM *) bs, drive, dirtrack, BAMSECT + 1);
0675
0676                  // both BAM sectors look almost the same:
0677                  lcopy((uint32_t) bs, (uint32_t) bs1, BLOCKSIZE);
0678
0679                  bs1->chntrack = dirtrack;  // first BAM sector points to second one
0680                  bs1->chnsector = BAMSECT + 1;  // next sector of BAM
0681                  if (dirtrack > 40)  {  // reset eventual dirtrack in upper BAM
0682                    bs1->entry[dirtrack - 41].free = 0x28;
0683                    bs1->entry[dirtrack - 41].alloc1 = 0xff;
0684                  }
0685                  if (dirtrack <= 40)  {
0686                    bs1->entry[dirtrack - 1].free = 0x24;  // occupy header, BAM and dirent
0687                    bs1->entry[dirtrack - 1].alloc1 = 0xf0;
0688                  }
0689
0690                  // create first empty header sector:
0691                  lfill((uint32_t) bs, 0, BLOCKSIZE);
0692                  hs->chntrack = dirtrack;  // first BAM sector points to second one
0693                  hs->chnsector = DIRENTSECT;
0694                  hs->diskdosversion = 0x44;
0695                  strcopy(name, (char *) hs->diskname, 16);
0696                  hs->unused1 = 0xa0;
0697                  hs->unused2 = 0xa0;
0698                  hs->diskid1 = ID_i;  // @@@@
0699                  hs->diskid2 = ID_d;
0700                  hs->unused3 = 0xa0;
0701                  hs->dosversion = 0x33;
0702                  hs->diskversion = 0x44;
0703                  hs->unused4 = 0xa0;
0704                  hs->unused5 = 0xa0;
0705
0706                  progress("Writing...", "BAM/header", 60);
0707                  PutWholeSector(legacyHDOSstate, (BAM *) bs, drive, dirtrack, HEADERSECT);
0708                }
0709
0710                void BAMAllocateTracks(unsigned char legacyHDOSstate, unsigned char side,
0711                                       unsigned char starttrack, unsigned char endtrack) {
0712                  unsigned char track80;
0713                  unsigned char sector;
0714
0715                  GetBAM(legacyHDOSstate, side);
0716                  for (track80 = starttrack; track80 <= endtrack; track80++)  {
0717                    for (sector = 0; sector < 40; sector++)  {
0718                      BAMSectorUpdate(BAMsector[0], BAMsector[1], track80, sector, 1); // 1=allocate
0719                    }
0720                  }
0721                }
