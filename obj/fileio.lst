0723                // @@@@ this has old filename handling and uses a BAM sector instead
0724                // @@@@ of passing a pointer:
0725                void getDiskname(unsigned char legacyHDOSstate,
0726                                 unsigned char drive, unsigned char dirtrack, char* diskname) {
0727                  HEADER* hs;
0728                  unsigned char i;
0729
0730                  // _miniInit();
0731
0732                  if (GetOneSector(legacyHDOSstate,
0733                                   BAMsector[0], drive, dirtrack, HEADERSECT) < 2)  {
0734                    hs = (HEADER*) BAMsector[0];
0735
0736                    i = 0;
0737                    while (hs->diskname[i] != 0xa0 && i < DOSFILENAMELEN)  {
0738                      diskname[i] = hs->diskname[i];
0739                      i++;
0740                    }
0741                    diskname[i] = 0;
0742                  } else {
0743                    strcopy("read error", (char *) diskname, 16);
0744                  }
0745                }
