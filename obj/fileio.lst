0451                // this expects data in sector buffer:
0452                void BAMSectorUpdate(BAM* BAMsector, BAM* BAMsector2, char track, char sector, char set) {
0453                  unsigned char bitshifter = 1;
0454
0455                //  BAMsector += $100;  // @@@@@ dirty test
0456                //  mprintf("BAMSectorUpdate BAMsector is:", (unsigned long) BAMsector);
0457
0458                  // next BAM sector of two in total:
0459                  if (track > 40)  {
0460                    track -= 40;
0461                    BAMsector = BAMsector2;
0462                  }
0463                #ifdef DEBUG
0464                        gotoxy(42, 20);
0465                        mh4printf("BAMsector ", (long) BAMsector);
0466                        cputln();
0467                        cgetc();
0468                #endif
0469                  
0470                  track--;  // access array zero based
0471                  if (set)  {  // if set clear alloc bit below to allocate:
0472                    if (sector < 8)  {
0473                      BAMsector->entry[track].alloc1 &= ~(bitshifter << sector);
0474                    }
0475                    else if (sector < 16)  {
0476                      BAMsector->entry[track].alloc2 &= ~(bitshifter << (sector - 8));
0477                    }
0478                    else if (sector < 24)  {
0479                      BAMsector->entry[track].alloc3 &= ~(bitshifter << (sector - 16));
0480                    }
0481                    else if (sector < 32)  {
0482                      BAMsector->entry[track].alloc4 &= ~(bitshifter << (sector - 24));
0483                    }
0484                    else  {
0485                      BAMsector->entry[track].alloc5 &= ~(bitshifter << (sector - 32));
0486                    }
0487                    BAMsector->entry[track].free--;
0488                  }
0489                  else  {
0490                    if (sector < 8)  {
0491                      BAMsector->entry[track].alloc1 |= (bitshifter << sector);
0492                    }
0493                    else if (sector < 16)  {
0494                      BAMsector->entry[track].alloc2 |= (bitshifter << (sector - 8));
0495                    }
0496                    else if (sector < 24)  {
0497                      BAMsector->entry[track].alloc3 |= (bitshifter << (sector - 16));
0498                    }
0499                    else if (sector < 32)  {
0500                      BAMsector->entry[track].alloc4 |= (bitshifter << (sector - 24));
0501                    }
0502                    else  {
0503                      BAMsector->entry[track].alloc5 |= (bitshifter << (sector - 32));
0504                    }
0505                    BAMsector->entry[track].free++;
0506                  }
0507                }
0508
0509                unsigned int BAMSectorsFreeBlocks(BAM* BAMsector, BAM* BAMsector2,
0510                                     unsigned char dirtrack,
0511                                     unsigned char firsttrack, unsigned char lasttrack) {
0512                  unsigned char track80;
0513                  unsigned char track;
0514                  unsigned int free = 0;
0515
0516                  // access track array zero based
0517                  for (track80 = (firsttrack - 1); track80 < lasttrack; track80++)  {
0518                    // next BAM sector of two in total:
0519                    if (track80 < 40)  {
0520                      track = track80;
0521                    } else {
0522                      track = track80 - 40;
0523                      BAMsector = BAMsector2;
0524                    }
0525
0526                    if (track80 != (dirtrack - 1))  {
0527                      free += BAMsector->entry[track].free;
0528                    }
0529                  }
0530
0531                  return free;
0532                }
0533
0534                unsigned int FreeBlocks(unsigned char legacyHDOSstate,
0535                                        unsigned char side, unsigned char dirtrack,
0536                                        unsigned char firsttrack, unsigned char lasttrack) {
0537                  GetBAM(legacyHDOSstate, side);
0538                  return BAMSectorsFreeBlocks(BAMsector[0], BAMsector[1], dirtrack,
0539                                              firsttrack, lasttrack);
0540                }
0541
0542                unsigned int BAMCheckSizeinFilebuffer(unsigned char legacyHDOSstate,
0543                                                      unsigned char drive, unsigned char side,
0544                                                      unsigned char dirtrack,
0545                                                      unsigned char firsttrack,
0546                                                      unsigned char lasttrack) {
0547                  BAM* bs;
0548
0549                  readblockchain(legacyHDOSstate, ATTICFILEBUFFER, BAMBLOCKS,
0550                                 drive, dirtrack, BAMSECT);
0551                  bs = BAMsector[0];
0552                  lcopy(ATTICFILEBUFFER, (uint32_t) bs, ATTICBAMBUFFERSIZE);
0553                  return BAMSectorsFreeBlocks(BAMsector[0], BAMsector[1], dirtrack,
0554                                              firsttrack, lasttrack);
0555                }
